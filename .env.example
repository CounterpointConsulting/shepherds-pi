# Shepherds Pi environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# GitHub PAT with repo scope (needed for agents to clone/push)
# Generate at: https://github.com/settings/tokens/new?scopes=repo
GIT_TOKEN=

# OpenRouter API key (alternative to pi auth storage)
# Only needed if not already stored via `pi --login openrouter`
OPENROUTER_API_KEY=
